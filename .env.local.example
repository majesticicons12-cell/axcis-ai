# ─── LLM Provider (pick at least one) ──────────────────────────────────────────
# Groq — https://console.groq.com/ (free tier available, recommended)
GROQ_API_KEY=gsk_...

# Anthropic — https://console.anthropic.com/ (used as fallback)
ANTHROPIC_API_KEY=sk-ant-...

# ─── Search (pick at least one) ──────────────────────────────────────────────
# Brave Search — https://brave.com/search/api/ (free, 2000 queries/month)
BRAVE_API_KEY=your-brave-api-key-here

# OR Google Custom Search — https://programmablesearchengine.google.com/
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_CX=your-google-cx-here

# ─── Supabase Auth + Database — https://supabase.com ──────────────────────────
# 1. Create a project at supabase.com
# 2. Settings → API → copy Project URL & anon key
# 3. Auth → Providers → enable Google
# 4. Run supabase/migrations/001_initial.sql in SQL Editor
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Optional ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
HF_API_KEY=
TELEGRAM_BOT_TOKEN=
